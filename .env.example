# Enter secrets in Vercel settings, never in GitHub or chat.
STRIPE_SECRET_KEY=
FOUNDER_BLOB_PATH=
# Private Blob store connection supplies its authentication configuration.
BLOB_READ_WRITE_TOKEN=
# Leave false until test checkout, delivery, terms and hosting are verified.
LAUNCH_ENABLED=false

STRIPE_WEBHOOK_SECRET=
# Existing Hostinger mailbox. Owner enters its password privately.
SMTP_PASSWORD=

# If support is an alias, use its actual sending mailbox login here.
SMTP_USER=support@smartbooksglobal.com
